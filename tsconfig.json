{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "examples",
    "mini-services",
    "skills",
    "download",
    "downloaded",
    "downloaded_v2",
    "backups",
    "server-single.ts",
    "server-standalone.ts",
    "src/engine/**/conformance-test.ts",
    "src/engine/**/*-conformance.ts",
    "src/engine/frontier/*-test.ts",
    "src/engine/frontier/reference-workflow-test-v2.ts",
    "src/engine/frontier/spawn-diagnostic.ts"
  ]
}
