{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://grandarchitect.local/schemas/authority-map.schema.json",
  "title": "Grand Architect Authority Map",
  "type": "object",
  "required": ["$schema", "schemaVersion", "precedence", "conflictPolicy"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string" },
    "precedence": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "type": "object",
        "required": ["rank", "kind", "description"],
        "additionalProperties": false,
        "properties": {
          "rank": { "type": "integer", "minimum": 1, "maximum": 7 },
          "kind": { "type": "string" },
          "description": { "type": "string" },
          "canonicalPaths": { "type": "array", "items": { "type": "string" } },
          "owner": { "type": "string" },
          "updateMechanism": { "type": "string" },
          "canOverride": { "type": "array", "items": { "type": "string" } },
          "cannotOverride": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "conflictPolicy": { "type": "string" },
    "knownDriftExamples": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description"],
        "additionalProperties": false,
        "properties": {
          "description": { "type": "string" },
          "documents": { "type": "array", "items": { "type": "string" } },
          "check": { "type": "string" }
        }
      }
    }
  }
}
